JWT_SECRET=change_this_to_a_random_32_char_string
DATABASE_URL=postgresql://kwhale:your_password@postgres:5432/kwhale
REDIS_URL=redis://redis:6379/0

# Public-facing Navidrome URL used for /stream 302 redirects. Must be reachable
# by clients (e.g. https://music.dueattendant149.org — fronted by Caddy with
# the /rest/* rule). Leave empty to 302 to the internal Docker hostname
# (NAVIDROME_URL above) — only correct for in-network clients / tests.
PUBLIC_NAVIDROME_URL=

# OpenAI-compatible API for embeddings and LLM vibe tags
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ICM Music partner key (for ICM source plugin)
ICM_PARTNER_KEY=
ICM_DEFAULT_REGION=us
ICM_FALLBACK_REGION=ru

# Auto-download threshold: play a remote track N times → auto-download
STREAM_AUTO_ACQUIRE_THRESHOLD=3
