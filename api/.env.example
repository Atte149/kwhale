# KWhale API Environment
# Copy to .env and fill in values.

# JWT secret for KWhale API auth (generate a random 32+ char string)
JWT_SECRET=generate_a_random_32_char_string_here

# Database (must match root .env POSTGRES_PASSWORD)
DATABASE_URL=postgresql://kwhale:your_password@postgres:5432/kwhale
REDIS_URL=redis://redis:6379/0

# OpenAI-compatible API for embeddings and LLM vibe tags
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# ICM Music partner key (for ICM source plugin — leave empty to disable)
ICM_PARTNER_KEY=
ICM_DEFAULT_REGION=us
ICM_FALLBACK_REGION=ru

# Auto-download threshold: play a remote track N times → auto-download
STREAM_AUTO_ACQUIRE_THRESHOLD=3

# Optional: Yandex Music token
YANDEX_MUSIC_TOKEN=

# Optional: multimodal model for spectrogram analysis
OMNI_MODEL=