# KWhale Worker Environment
# Copy to .env and fill in values.

# Database (must match root .env POSTGRES_PASSWORD)
DATABASE_URL=postgresql://kwhale:your_password@postgres:5432/kwhale
REDIS_URL=redis://redis:6379/0

# Navidrome DB path inside the worker container
NAVIDROME_DB=/navidrome/navidrome.db

# Source plugins (leave empty to disable)
YANDEX_MUSIC_TOKEN=
ICM_PARTNER_KEY=
ICM_PARTNER_USER_ID=
ICM_DEFAULT_REGION=us
ICM_FALLBACK_REGION=ru

# Embeddings + LLM (must match api/.env)
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-...
EMBED_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Optional: multimodal model for spectrogram analysis
OMNI_MODEL=