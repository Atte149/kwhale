# KWhale MCP Environment
# Copy to .env and fill in values.

# Database (must match root .env POSTGRES_PASSWORD)
DATABASE_URL=postgresql://kwhale:your_password@postgres:5432/kwhale

# Navidrome connection (internal Docker network)
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=change_me_to_a_secure_password

# KWhale API URL (internal Docker network)
KWHALE_API_URL=http://api:8000