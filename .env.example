# KWhale — Root Environment File
# Copy to .env and fill in values before running `docker compose up`.

# ── Data root (all volumes will be under this path) ──────────────────────────
DATA_ROOT=./kwhale-data

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_to_a_secure_password
DATABASE_URL=postgresql://kwhale:${POSTGRES_PASSWORD}@postgres:5432/kwhale

# ── Gonic (Subsonic media server) ──────────────────────────────────────────────
# Gonic creates admin/admin by default — change in web UI after first boot
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=change_me_to_a_secure_password

# ── Public Gonic URL (optional) ───────────────────────────────────────────────
# The public-facing URL clients use to reach Gonic (e.g. https://music.example.com).
# Used for cover art URLs in the API response. Leave empty for internal Docker hostname.
PUBLIC_NAVIDROME_URL=

# ── Optional: Yandex Music token (for Yandex source plugin) ──────────────────
YANDEX_MUSIC_TOKEN=

# ── Optional: SoundCloud client_id (for SoundCloud source plugin) ────────────
SOUNDCLOUD_CLIENT_ID=

# ── Optional: ICM Partner Key (for ICM source plugin) ────────────────────────
ICM_PARTNER_KEY=