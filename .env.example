# KWhale — Root Environment File
# Copy to .env and fill in values before running `docker compose up`.

# ── Data root (all volumes will be under this path) ──────────────────────────
DATA_ROOT=./kwhale-data

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_to_a_secure_password
DATABASE_URL=postgresql://kwhale:${POSTGRES_PASSWORD}@postgres:5432/kwhale

# ── Navidrome (media engine, internal) ────────────────────────────────────────
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=change_me_to_a_secure_password

# ── Public Navidrome URL (optional) ───────────────────────────────────────────
# The public-facing URL clients use to reach Navidrome (e.g. https://music.example.com).
# Leave empty to use the internal Docker hostname (only works for in-network clients).
PUBLIC_NAVIDROME_URL=

# ── Optional: Yandex Music token (for Yandex source plugin) ──────────────────
YANDEX_MUSIC_TOKEN=