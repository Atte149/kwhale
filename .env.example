# Melorise — Root Environment File
# Copy to .env and fill in values

# ── Data root (all volumes will be under this path) ──────────────────────────
DATA_ROOT=/files/melorise/data

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://melorise:${POSTGRES_PASSWORD}@postgres:5432/melorise

# ── Navidrome (media engine, internal) ────────────────────────────────────────
NAVIDROME_USERNAME=admin
NAVIDROME_PASSWORD=your_password_here

# ── Optional: Yandex Music token (for Yandex source plugin) ──────────────────
YANDEX_MUSIC_TOKEN=
